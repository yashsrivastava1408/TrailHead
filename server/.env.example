# Copy to server/.env and fill in. Never commit .env.

PORT=4000
CORS_ORIGIN=http://localhost:5173
DB_PATH=./data/trailhead.db

# --- LLM (any OpenAI-compatible endpoint) ---
# groq   : free hosted Llama 3.3 70B   -> key from https://console.groq.com
# ollama : fully local, no key         -> `ollama pull llama3.1:8b`
# openai : any OpenAI-compatible host
LLM_PROVIDER=groq
GROQ_API_KEY=
# Which models your key can use differs per account (Groq console > Model Permissions).
# The server warns at startup if this model is not available. Examples:
#   llama-3.3-70b-versatile   (Meta Llama)
#   openai/gpt-oss-120b       (open-weight, available on many accounts)
# Optional overrides:
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=
# LLM_API_KEY=

# Optional: raises GitHub's limit from 60 to 5000 requests/hour
GITHUB_TOKEN=
